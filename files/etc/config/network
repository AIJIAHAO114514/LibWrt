# ===== WAN PPPoE =====
config interface 'wan'
        option device 'wan'
        option proto 'pppoe'
        option username 'YOUR_PPPOE_ACCOUNT'
        option password 'YOUR_PPPOE_PASSWORD'
        option ipv6 'auto'

config interface 'wan6'
        option device '@wan'
        option proto 'dhcpv6'

# ===== VLAN 10 — 管理网段 =====
config interface 'lan'
        option device 'br-lan.10'
        option proto 'static'
        option ipaddr '192.168.0.1'
        option netmask '255.255.255.0'
        option ip6assign '60'

